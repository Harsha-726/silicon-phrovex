# Server-only. Never prefix this with VITE_ or expose it in client code.
GROQ_API_KEY=

# Client-safe configuration. These values may be exposed in the browser.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_DOMAIN=
VITE_CLERK_PROXY_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only configuration for the authenticated repository adapter.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_PROXY_URL=
FEEDBACK_ADMIN_KEY=
MOMENT_WEBHOOK_TOKEN=
# Fixed Clerk account for voice-created Moments. The email fallback uses the
# server-only Clerk secret to resolve the production user ID.
MOMENT_WEBHOOK_USER_ID=
MOMENT_WEBHOOK_OWNER_EMAIL=

# Server-only configuration for Silico Study. Keep the feature disabled until
# the Gemini key, free-tier quota, and privacy notice have been reviewed.
STUDY_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.6-flash
# Used only if Gemini Flash returns a transient 503 overload response.
GEMINI_FLASH_FALLBACK_MODEL=gemini-3.5-flash-lite
# Reserved for the backend paid tier; not exposed in the current UI.
GEMINI_PRO_MODEL=gemini-2.5-pro
STUDY_FREE_BASIC_MONTHLY_LIMIT=10
STUDY_FREE_ADVANCED_MONTHLY_LIMIT=0
STUDY_FREE_MAX_INPUT_TOKENS=100000
STUDY_FREE_MONTHLY_COST_CENTS=200
STUDY_FREE_DAILY_REQUEST_LIMIT=3
STUDY_BASIC_MONTHLY_LIMIT=25
STUDY_ADVANCED_MONTHLY_LIMIT=5
STUDY_MAX_INPUT_TOKENS=50000
STUDY_MAX_OUTPUT_TOKENS=4000
STUDY_DAILY_REQUEST_LIMIT=10
STUDY_MONTHLY_COST_CENTS=1000
STUDY_GLOBAL_MONTHLY_COST_CENTS=10000
STUDY_ADVANCED_BASIC_MONTHLY_LIMIT=60
STUDY_ADVANCED_ADVANCED_MONTHLY_LIMIT=20
STUDY_ADVANCED_MAX_INPUT_TOKENS=100000
STUDY_ADVANCED_DAILY_REQUEST_LIMIT=20
STUDY_ADVANCED_MONTHLY_COST_CENTS=2500

# Server-only Stripe billing configuration. Create recurring Prices in Stripe
# and paste only their price IDs here; never expose the secret or webhook key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_ANNUAL=
STRIPE_PRICE_ADVANCED_MONTHLY=
STRIPE_API_VERSION=2026-08-26.dahlia

# Server-only configuration for calendar feed URLs.
APP_URL=https://silico.phrovex.com
